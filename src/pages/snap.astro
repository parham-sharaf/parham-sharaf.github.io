---
import Base from '../layouts/Base.astro';
---

<Base title="Snap" description="Photograph something and get Claude's answer" width="prose" noindex>
  <section class="pb-6">
    <h1 class="text-4xl font-semibold tracking-tight">Snap</h1>
    <p class="mt-3 text-sm" style="color: var(--color-fg-muted);">
      Tap to capture. Answers sync to every device.
    </p>
  </section>

  <div class="snap-tabs" role="tablist">
    <button role="tab" data-tab="capture" aria-selected="true">Capture</button>
    <button role="tab" data-tab="answers" aria-selected="false">Answers <span id="snap-count"></span></button>
    <button role="tab" data-tab="settings" aria-selected="false">Settings</button>
  </div>

  <section data-panel="capture" class="snap-panel">
    <div class="snap-cam">
      <video id="snap-video" playsinline muted autoplay></video>
      <div id="snap-flash" class="snap-flash"></div>
      <label id="snap-fallback" class="snap-fallback" for="snap-file" hidden>Tap to take a photo</label>
      <button id="snap-shutter" class="snap-shutter" aria-label="Capture"></button>
    </div>
    <input id="snap-file" type="file" accept="image/*" capture="environment" hidden />
    <p id="snap-status" class="snap-status"></p>
  </section>

  <section data-panel="answers" class="snap-panel" hidden>
    <p id="snap-empty" class="snap-status">No answers yet.</p>
    <ol id="snap-list" class="snap-list"></ol>
    <button id="snap-clear" class="snap-secondary" hidden>Clear history</button>
  </section>

  <section data-panel="settings" class="snap-panel" hidden>
    <label class="snap-label" for="snap-key">Passphrase</label>
    <input id="snap-key" type="password" autocomplete="off" placeholder="Snap passphrase" />
    <p class="snap-status">
      Enter it once per device. Answers sync across every device that has it.
    </p>
    <button id="snap-save-key" class="snap-primary">Save</button>
  </section>
</Base>

<style>
  .snap-tabs {
    display: flex;
    gap: 0.25rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1.25rem;
  }
  .snap-tabs button {
    padding: 0.6rem 0.9rem;
    font-size: 0.875rem;
    color: var(--color-fg-dim);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .snap-tabs button[aria-selected='true'] {
    color: var(--color-fg);
    border-bottom-color: var(--color-accent);
  }
  #snap-count {
    font-family: var(--font-mono);
    color: var(--color-accent);
  }
  .snap-panel {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .snap-panel[hidden] {
    display: none;
  }
  .snap-cam {
    position: relative;
    aspect-ratio: 3 / 4;
    max-height: 72vh;
    width: 100%;
    border-radius: 0.75rem;
    overflow: hidden;
    background: #000;
  }
  .snap-cam video {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .snap-flash {
    position: absolute;
    inset: 0;
    background: #fff;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease-out;
  }
  .snap-flash.on {
    opacity: 0.7;
    transition: none;
  }
  .snap-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ddd;
    cursor: pointer;
  }
  .snap-fallback[hidden] {
    display: none;
  }
  .snap-shutter {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    width: 4.5rem;
    height: 4.5rem;
    transform: translateX(-50%);
    border-radius: 50%;
    background: #fff;
    border: 4px solid rgba(255, 255, 255, 0.45);
    background-clip: padding-box;
    box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.25);
  }
  .snap-shutter:active {
    transform: translateX(-50%) scale(0.92);
  }
  .snap-shutter[hidden] {
    display: none;
  }
  .snap-panel textarea,
  .snap-panel input[type='password'] {
    width: 100%;
    padding: 0.7rem 0.8rem;
    font-size: 1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.5rem;
    background: var(--color-bg-soft);
    color: var(--color-fg);
  }
  .snap-label {
    font-size: 0.8rem;
    color: var(--color-fg-dim);
    font-family: var(--font-mono);
  }
  .snap-primary {
    padding: 0.8rem;
    border-radius: 0.5rem;
    font-weight: 600;
    background: var(--color-accent);
    color: var(--color-bg);
  }
  .snap-primary:disabled {
    opacity: 0.4;
  }
  .snap-secondary {
    align-self: flex-start;
    font-size: 0.8rem;
    color: var(--color-fg-dim);
    text-decoration: underline;
  }
  .snap-status {
    font-size: 0.8rem;
    color: var(--color-fg-dim);
  }
  .snap-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  :global(.snap-item) {
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-bg-soft);
    padding: 0.9rem;
  }
  :global(.snap-item-head) {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-top: 0.75rem;
  }
  :global(.snap-item-head img) {
    width: 2.25rem;
    height: 2.25rem;
    object-fit: cover;
    border-radius: 0.4rem;
    flex-shrink: 0;
  }
  :global(.snap-item-meta) {
    font-size: 0.75rem;
    color: var(--color-fg-dim);
    font-family: var(--font-mono);
  }
  :global(.snap-item-note) {
    font-size: 0.85rem;
    color: var(--color-fg-muted);
    margin-top: 0.2rem;
  }
  :global(.snap-item-answer) {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 1rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  :global(.snap-item-result) {
    font-size: 1.15rem;
    font-weight: 600;
    white-space: pre-wrap;
  }
  :global(.snap-item-answer pre) {
    margin: 0;
    padding: 0.8rem;
    border-radius: 0.5rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.5;
    overflow-wrap: normal;
  }
  :global(.snap-item-why) {
    margin-top: 0.6rem;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--color-fg-dim);
  }
  :global(.snap-item-why[hidden]) {
    display: none;
  }
  :global(.snap-item-answer.is-error) {
    color: var(--color-accent);
  }
</style>

<script>
  // Cloudflare Worker in ~/Workspace/snap-worker: stores answers and calls Claude.
  const API = 'https://snap.snap-worker.workers.dev';
  const KEY_STORE = 'snap:token';
  const TAB_STORE = 'snap:tab';
  const LENS_STORE = 'snap:lens';
  const SPLIT = '===WHY===';

  interface Entry {
    id: string;
    at: number;
    thumb: string;
    note: string;
    answer: string;
    error?: boolean;
    pending?: boolean;
  }

  // Phone photos are several MB; Claude reads ~1568px on the long edge at most.
  async function resize(source: ImageBitmapSource, maxEdge: number, quality: number): Promise<string> {
    const bitmap = await createImageBitmap(source);
    const scale = Math.min(1, maxEdge / Math.max(bitmap.width, bitmap.height));
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(bitmap.width * scale);
    canvas.height = Math.round(bitmap.height * scale);
    canvas.getContext('2d')!.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
    bitmap.close();
    return canvas.toDataURL('image/jpeg', quality);
  }

  function setup() {
    const root = document.querySelector('[data-panel="capture"]');
    if (!root || root.hasAttribute('data-ready')) return;
    root.setAttribute('data-ready', '');

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const fileInput = $<HTMLInputElement>('snap-file');
    const video = $<HTMLVideoElement>('snap-video');
    const flash = $('snap-flash');
    const fallback = $('snap-fallback');
    const shutter = $<HTMLButtonElement>('snap-shutter');
    const status = $('snap-status');
    const list = $('snap-list');
    const empty = $('snap-empty');
    const count = $('snap-count');
    const clearBtn = $<HTMLButtonElement>('snap-clear');
    const keyInput = $<HTMLInputElement>('snap-key');

    let history: Entry[] = [];
    let stream: MediaStream | null = null;
    let inFlight = 0;
    let pollTimer: number | undefined;

    function getToken(): string {
      try {
        return localStorage.getItem(KEY_STORE) ?? '';
      } catch {
        return '';
      }
    }

    async function call(path: string, init: RequestInit = {}): Promise<Response> {
      const res = await fetch(API + path, {
        ...init,
        headers: { Authorization: `Bearer ${getToken()}`, 'Content-Type': 'application/json' },
      });
      if (res.status === 401) {
        showTab('settings');
        throw new Error('Wrong passphrase. Check Settings.');
      }
      if (!res.ok) throw new Error(((await res.json().catch(() => ({}))) as { error?: string }).error ?? `Error ${res.status}`);
      return res;
    }

    keyInput.value = getToken() ? '••••••••' : '';

    function showTab(name: string) {
      document.querySelectorAll<HTMLButtonElement>('.snap-tabs button').forEach((b) => {
        b.setAttribute('aria-selected', String(b.dataset.tab === name));
      });
      document.querySelectorAll<HTMLElement>('.snap-panel').forEach((p) => {
        p.hidden = p.dataset.panel !== name;
      });
      try {
        localStorage.setItem(TAB_STORE, name);
      } catch {}
      if (name === 'capture') startCamera();
      else stopCamera();
    }

    // Live preview so one tap captures; the native camera always asks "Use Photo".
    async function startCamera() {
      if (stream || document.visibilityState !== 'visible') return;
      try {
        stream = await openWideCamera();
        video.srcObject = stream;
        await video.play().catch(() => {});
        fallback.hidden = true;
        shutter.hidden = false;
      } catch {
        stream = null;
        fallback.hidden = false;
        shutter.hidden = true;
      }
    }

    // Prefer the 0.5x ultra wide lens. Labels only appear after permission, so the
    // first visit opens the default back camera, finds the ultra wide, then switches.
    async function openWideCamera(): Promise<MediaStream> {
      const size = { width: { ideal: 3840 }, height: { ideal: 2160 } };
      let saved = '';
      try {
        saved = localStorage.getItem(LENS_STORE) ?? '';
      } catch {}
      if (saved) {
        try {
          return await navigator.mediaDevices.getUserMedia({ audio: false, video: { deviceId: { exact: saved }, ...size } });
        } catch {}
      }
      const s = await navigator.mediaDevices.getUserMedia({ audio: false, video: { facingMode: 'environment', ...size } });
      const devices = await navigator.mediaDevices.enumerateDevices();
      const ultra = devices.find((d) => d.kind === 'videoinput' && /ultra ?wide/i.test(d.label));
      if (ultra && ultra.deviceId !== s.getVideoTracks()[0].getSettings().deviceId) {
        s.getTracks().forEach((t) => t.stop());
        const wide = await navigator.mediaDevices.getUserMedia({ audio: false, video: { deviceId: { exact: ultra.deviceId }, ...size } });
        try {
          localStorage.setItem(LENS_STORE, ultra.deviceId);
        } catch {}
        return wide;
      }
      // No separate ultra wide device: zoom out as far as this camera allows.
      const track = s.getVideoTracks()[0];
      const zoom = (track.getCapabilities?.() as { zoom?: { min: number } } | undefined)?.zoom;
      if (zoom) await track.applyConstraints({ advanced: [{ zoom: zoom.min } as MediaTrackConstraintSet] }).catch(() => {});
      return s;
    }

    function stopCamera() {
      stream?.getTracks().forEach((t) => t.stop());
      stream = null;
      video.srcObject = null;
    }

    function updateStatus(msg?: string) {
      status.textContent = msg ?? (inFlight ? `Sending ${inFlight}…` : 'Sent ✓');
    }

    async function send(source: ImageBitmapSource) {
      if (!getToken()) {
        showTab('settings');
        return;
      }
      inFlight++;
      updateStatus();
      try {
        const [full, thumb] = await Promise.all([resize(source, 1568, 0.8), resize(source, 160, 0.6)]);
        await call('/entries', { method: 'POST', body: JSON.stringify({ image: full.split(',')[1], thumb, note: '' }) });
        inFlight--;
        updateStatus();
      } catch (err) {
        inFlight--;
        updateStatus(err instanceof Error ? err.message : 'Upload failed.');
      }
    }

    // Splits "answer ===WHY=== explanation" and renders fenced code as <pre>.
    function fillAnswer(li: HTMLElement, e: Entry) {
      const answer = li.querySelector<HTMLElement>('.snap-item-answer')!;
      const why = li.querySelector<HTMLElement>('.snap-item-why')!;
      answer.classList.toggle('is-error', !!e.error);
      if (e.error) {
        answer.textContent = e.answer;
        why.hidden = true;
        return;
      }
      const cut = e.answer.indexOf(SPLIT);
      const main = (cut === -1 ? e.answer : e.answer.slice(0, cut)).trim();
      const rest = cut === -1 ? '' : e.answer.slice(cut + SPLIT.length).trim();
      const parts = main.split(/```[^\n]*\n?/);
      answer.replaceChildren(
        ...parts
          .map((text, i) => {
            if (i % 2 === 1) {
              const pre = document.createElement('pre');
              const code = document.createElement('code');
              code.textContent = text.replace(/\n$/, '');
              pre.append(code);
              return pre;
            }
            if (!text.trim()) return null;
            const p = document.createElement('p');
            p.className = 'snap-item-result';
            p.textContent = text.trim();
            return p;
          })
          .filter((n): n is HTMLParagraphElement | HTMLPreElement => n !== null),
      );
      if (!main && e.pending) answer.textContent = 'Thinking…';
      why.textContent = rest;
      why.hidden = !rest;
    }

    function render() {
      list.replaceChildren(
        ...history.map((e) => {
          const li = document.createElement('li');
          li.className = 'snap-item';
          const head = document.createElement('div');
          head.className = 'snap-item-head';
          const img = document.createElement('img');
          img.src = e.thumb;
          img.alt = '';
          const meta = document.createElement('div');
          const time = document.createElement('div');
          time.className = 'snap-item-meta';
          time.textContent = new Date(e.at).toLocaleString() + (e.pending ? ' · thinking…' : '');
          meta.append(time);
          if (e.note) {
            const n = document.createElement('div');
            n.className = 'snap-item-note';
            n.textContent = e.note;
            meta.append(n);
          }
          head.append(img, meta);
          const answer = document.createElement('div');
          answer.className = 'snap-item-answer';
          const why = document.createElement('p');
          why.className = 'snap-item-why';
          li.append(answer, why, head);
          fillAnswer(li, e);
          return li;
        }),
      );
      empty.hidden = history.length > 0;
      clearBtn.hidden = history.length === 0;
      count.textContent = history.length ? String(history.length) : '';
    }

    // Poll fast while something is thinking, slowly otherwise, never while hidden.
    async function refresh() {
      clearTimeout(pollTimer);
      if (!getToken()) return;
      try {
        const next = (await (await call('/entries')).json()) as Entry[];
        if (JSON.stringify(next) !== JSON.stringify(history)) {
          history = next;
          render();
        }
        empty.textContent = 'No answers yet.';
      } catch (err) {
        empty.textContent = err instanceof Error ? err.message : 'Could not load answers.';
      }
      if (document.visibilityState === 'visible') {
        pollTimer = window.setTimeout(refresh, history.some((e) => e.pending) ? 2000 : 8000);
      }
    }

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') {
        refresh();
        if (!document.querySelector<HTMLElement>('[data-panel="capture"]')!.hidden) startCamera();
      } else {
        stopCamera();
      }
    });
    document.addEventListener('astro:before-swap', stopCamera, { once: true });

    document.querySelectorAll<HTMLButtonElement>('.snap-tabs button').forEach((b) => {
      b.addEventListener('click', () => {
        showTab(b.dataset.tab!);
        if (b.dataset.tab === 'answers') refresh();
      });
    });

    shutter.addEventListener('click', async () => {
      if (!video.videoWidth) return;
      flash.classList.add('on');
      requestAnimationFrame(() => requestAnimationFrame(() => flash.classList.remove('on')));
      // Grab the frame now so the upload uses what was on screen at the tap.
      const frame = document.createElement('canvas');
      frame.width = video.videoWidth;
      frame.height = video.videoHeight;
      frame.getContext('2d')!.drawImage(video, 0, 0);
      send(frame);
    });

    // Fallback when the camera can't be opened in page (permission denied, old browser).
    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      fileInput.value = '';
      if (file) send(file);
    });

    clearBtn.addEventListener('click', async () => {
      if (!confirm('Delete all saved answers on every device?')) return;
      await call('/entries', { method: 'DELETE' }).catch(() => {});
      refresh();
    });

    $('snap-save-key').addEventListener('click', () => {
      const v = keyInput.value.trim();
      if (!v || v.startsWith('••')) return;
      try {
        localStorage.setItem(KEY_STORE, v);
      } catch {}
      keyInput.value = '••••••••';
      showTab('capture');
      status.textContent = 'Saved.';
      refresh();
    });

    let lastTab = 'capture';
    try {
      lastTab = localStorage.getItem(TAB_STORE) ?? 'capture';
    } catch {}
    showTab(getToken() ? lastTab : 'settings');
    refresh();
  }

  setup();
  document.addEventListener('astro:page-load', setup);
</script>

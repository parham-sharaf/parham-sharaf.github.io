---
import Base from '../layouts/Base.astro';
---

<Base title="Snap" description="Photograph something and get Claude's answer" width="prose" noindex>
  <section class="pb-6">
    <h1 class="text-4xl font-semibold tracking-tight">Snap</h1>
    <p class="mt-3 text-sm" style="color: var(--color-fg-muted);">
      Take a photo, send it to Claude, read the answer in the Answers tab.
    </p>
  </section>

  <div class="snap-tabs" role="tablist">
    <button role="tab" data-tab="capture" aria-selected="true">Capture</button>
    <button role="tab" data-tab="answers" aria-selected="false">Answers <span id="snap-count"></span></button>
    <button role="tab" data-tab="settings" aria-selected="false">Settings</button>
  </div>

  <section data-panel="capture" class="snap-panel">
    <label class="snap-drop" for="snap-file">
      <img id="snap-preview" alt="" hidden />
      <span id="snap-drop-label">Tap to take a photo</span>
    </label>
    <input id="snap-file" type="file" accept="image/*" capture="environment" hidden />
    <textarea id="snap-note" rows="2" placeholder="Optional: what do you want to know about it?"></textarea>
    <button id="snap-send" class="snap-primary" disabled>Ask Claude</button>
    <p id="snap-status" class="snap-status"></p>
  </section>

  <section data-panel="answers" class="snap-panel" hidden>
    <p id="snap-empty" class="snap-status">No answers yet.</p>
    <ol id="snap-list" class="snap-list"></ol>
    <button id="snap-clear" class="snap-secondary" hidden>Clear history</button>
  </section>

  <section data-panel="settings" class="snap-panel" hidden>
    <label class="snap-label" for="snap-key">Anthropic API key</label>
    <input id="snap-key" type="password" autocomplete="off" placeholder="sk-ant-..." />
    <p class="snap-status">
      Stored only in this browser. Requests go straight from this device to the Anthropic API.
    </p>
    <button id="snap-save-key" class="snap-primary">Save key</button>
  </section>
</Base>

<style>
  .snap-tabs {
    display: flex;
    gap: 0.25rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1.25rem;
  }
  .snap-tabs button {
    padding: 0.6rem 0.9rem;
    font-size: 0.875rem;
    color: var(--color-fg-dim);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .snap-tabs button[aria-selected='true'] {
    color: var(--color-fg);
    border-bottom-color: var(--color-accent);
  }
  #snap-count {
    font-family: var(--font-mono);
    color: var(--color-accent);
  }
  .snap-panel {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .snap-panel[hidden] {
    display: none;
  }
  .snap-drop {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 14rem;
    border: 1px dashed var(--color-border-strong);
    border-radius: 0.75rem;
    background: var(--color-bg-soft);
    color: var(--color-fg-muted);
    cursor: pointer;
    overflow: hidden;
  }
  .snap-drop img {
    max-height: 22rem;
    width: 100%;
    object-fit: contain;
  }
  .snap-panel textarea,
  .snap-panel input[type='password'] {
    width: 100%;
    padding: 0.7rem 0.8rem;
    font-size: 1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.5rem;
    background: var(--color-bg-soft);
    color: var(--color-fg);
  }
  .snap-label {
    font-size: 0.8rem;
    color: var(--color-fg-dim);
    font-family: var(--font-mono);
  }
  .snap-primary {
    padding: 0.8rem;
    border-radius: 0.5rem;
    font-weight: 600;
    background: var(--color-accent);
    color: var(--color-bg);
  }
  .snap-primary:disabled {
    opacity: 0.4;
  }
  .snap-secondary {
    align-self: flex-start;
    font-size: 0.8rem;
    color: var(--color-fg-dim);
    text-decoration: underline;
  }
  .snap-status {
    font-size: 0.8rem;
    color: var(--color-fg-dim);
  }
  .snap-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  :global(.snap-item) {
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-bg-soft);
    padding: 0.9rem;
  }
  :global(.snap-item-head) {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    margin-bottom: 0.6rem;
  }
  :global(.snap-item-head img) {
    width: 4rem;
    height: 4rem;
    object-fit: cover;
    border-radius: 0.4rem;
    flex-shrink: 0;
  }
  :global(.snap-item-meta) {
    font-size: 0.75rem;
    color: var(--color-fg-dim);
    font-family: var(--font-mono);
  }
  :global(.snap-item-note) {
    font-size: 0.85rem;
    color: var(--color-fg-muted);
    margin-top: 0.2rem;
  }
  :global(.snap-item-answer) {
    white-space: pre-wrap;
    font-size: 0.95rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }
  :global(.snap-item-answer.is-error) {
    color: var(--color-accent);
  }
</style>

<script>
  import Anthropic from '@anthropic-ai/sdk';

  const KEY_STORE = 'snap:key';
  const HISTORY_STORE = 'snap:history';
  const MAX_ITEMS = 30;

  interface Entry {
    id: string;
    at: number;
    thumb: string;
    note: string;
    answer: string;
    error?: boolean;
    pending?: boolean;
  }

  function load<T>(key: string, fallback: T): T {
    try {
      const raw = localStorage.getItem(key);
      return raw ? (JSON.parse(raw) as T) : fallback;
    } catch {
      return fallback;
    }
  }

  function save(key: string, value: unknown) {
    try {
      localStorage.setItem(key, typeof value === 'string' ? value : JSON.stringify(value));
    } catch {}
  }

  // Phone photos are several MB; Claude reads ~1568px on the long edge at most.
  async function resize(file: File, maxEdge: number, quality: number): Promise<string> {
    const bitmap = await createImageBitmap(file);
    const scale = Math.min(1, maxEdge / Math.max(bitmap.width, bitmap.height));
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(bitmap.width * scale);
    canvas.height = Math.round(bitmap.height * scale);
    canvas.getContext('2d')!.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
    bitmap.close();
    return canvas.toDataURL('image/jpeg', quality);
  }

  function setup() {
    const root = document.querySelector('[data-panel="capture"]');
    if (!root || root.hasAttribute('data-ready')) return;
    root.setAttribute('data-ready', '');

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const fileInput = $<HTMLInputElement>('snap-file');
    const preview = $<HTMLImageElement>('snap-preview');
    const dropLabel = $('snap-drop-label');
    const note = $<HTMLTextAreaElement>('snap-note');
    const sendBtn = $<HTMLButtonElement>('snap-send');
    const status = $('snap-status');
    const list = $('snap-list');
    const empty = $('snap-empty');
    const count = $('snap-count');
    const clearBtn = $<HTMLButtonElement>('snap-clear');
    const keyInput = $<HTMLInputElement>('snap-key');

    let history = load<Entry[]>(HISTORY_STORE, []).map((e) =>
      e.pending ? { ...e, pending: false, error: true, answer: e.answer || 'Interrupted.' } : e,
    );
    let currentFile: File | null = null;
    function getKey(): string {
      try {
        return localStorage.getItem(KEY_STORE) ?? '';
      } catch {
        return '';
      }
    }

    keyInput.value = getKey() ? '••••••••' : '';

    function showTab(name: string) {
      document.querySelectorAll<HTMLButtonElement>('.snap-tabs button').forEach((b) => {
        b.setAttribute('aria-selected', String(b.dataset.tab === name));
      });
      document.querySelectorAll<HTMLElement>('.snap-panel').forEach((p) => {
        p.hidden = p.dataset.panel !== name;
      });
    }

    function persist() {
      save(HISTORY_STORE, history.slice(0, MAX_ITEMS));
    }

    function render() {
      list.replaceChildren(
        ...history.map((e) => {
          const li = document.createElement('li');
          li.className = 'snap-item';
          li.dataset.id = e.id;
          const head = document.createElement('div');
          head.className = 'snap-item-head';
          const img = document.createElement('img');
          img.src = e.thumb;
          img.alt = '';
          const meta = document.createElement('div');
          const time = document.createElement('div');
          time.className = 'snap-item-meta';
          time.textContent = new Date(e.at).toLocaleString() + (e.pending ? ' · thinking…' : '');
          meta.append(time);
          if (e.note) {
            const n = document.createElement('div');
            n.className = 'snap-item-note';
            n.textContent = e.note;
            meta.append(n);
          }
          head.append(img, meta);
          const answer = document.createElement('div');
          answer.className = 'snap-item-answer' + (e.error ? ' is-error' : '');
          answer.textContent = e.answer;
          li.append(head, answer);
          return li;
        }),
      );
      empty.hidden = history.length > 0;
      clearBtn.hidden = history.length === 0;
      count.textContent = history.length ? String(history.length) : '';
    }

    function update(id: string, patch: Partial<Entry>) {
      history = history.map((e) => (e.id === id ? { ...e, ...patch } : e));
      const e = history.find((x) => x.id === id);
      const li = list.querySelector<HTMLElement>(`[data-id="${id}"]`);
      if (e && li) {
        const answer = li.querySelector<HTMLElement>('.snap-item-answer')!;
        answer.textContent = e.answer;
        answer.classList.toggle('is-error', !!e.error);
        li.querySelector('.snap-item-meta')!.textContent =
          new Date(e.at).toLocaleString() + (e.pending ? ' · thinking…' : '');
      }
    }

    async function ask(entry: Entry, imageDataUrl: string) {
      const client = new Anthropic({ apiKey: getKey(), dangerouslyAllowBrowser: true });
      const prompt = entry.note
        ? entry.note
        : 'Read this image. If it contains a question or problem, answer it. Otherwise explain what it shows and anything useful to know.';
      try {
        const stream = client.beta.messages.stream({
          model: 'claude-opus-5-5',
          max_tokens: 16000,
          betas: ['server-side-fallback-2026-07-01'],
          fallbacks: 'default',
          output_config: { effort: 'medium' },
          system:
            'The user sends a phone photo. Give a clear, direct answer they can read on a phone. Plain text, short paragraphs, no markdown tables.',
          messages: [
            {
              role: 'user',
              content: [
                {
                  type: 'image',
                  source: {
                    type: 'base64',
                    media_type: 'image/jpeg',
                    data: imageDataUrl.split(',')[1],
                  },
                },
                { type: 'text', text: prompt },
              ],
            },
          ],
        });
        let text = '';
        stream.on('text', (delta) => {
          text += delta;
          update(entry.id, { answer: text });
        });
        const final = await stream.finalMessage();
        if (final.stop_reason === 'refusal') {
          update(entry.id, { pending: false, error: true, answer: text || 'Claude declined to answer this one.' });
        } else {
          update(entry.id, { pending: false });
        }
      } catch (err) {
        let msg = 'Something went wrong.';
        if (err instanceof Anthropic.AuthenticationError) msg = 'Invalid API key. Check the Settings tab.';
        else if (err instanceof Anthropic.RateLimitError) msg = 'Rate limited. Try again in a moment.';
        else if (err instanceof Anthropic.APIError) msg = `API error ${err.status ?? ''}: ${err.message}`;
        else if (err instanceof Error) msg = err.message;
        update(entry.id, { pending: false, error: true, answer: msg });
      }
      persist();
    }

    document.querySelectorAll<HTMLButtonElement>('.snap-tabs button').forEach((b) => {
      b.addEventListener('click', () => showTab(b.dataset.tab!));
    });

    fileInput.addEventListener('change', () => {
      currentFile = fileInput.files?.[0] ?? null;
      if (!currentFile) return;
      preview.src = URL.createObjectURL(currentFile);
      preview.hidden = false;
      dropLabel.hidden = true;
      sendBtn.disabled = false;
      status.textContent = '';
    });

    sendBtn.addEventListener('click', async () => {
      if (!currentFile) return;
      if (!getKey()) {
        status.textContent = 'Add your API key in Settings first.';
        showTab('settings');
        return;
      }
      sendBtn.disabled = true;
      status.textContent = 'Preparing photo…';
      let full: string, thumb: string;
      try {
        [full, thumb] = await Promise.all([resize(currentFile, 1568, 0.85), resize(currentFile, 160, 0.6)]);
      } catch {
        status.textContent = "Couldn't read that image. Try another photo.";
        sendBtn.disabled = false;
        return;
      }
      const entry: Entry = {
        id: crypto.randomUUID(),
        at: Date.now(),
        thumb,
        note: note.value.trim(),
        answer: '',
        pending: true,
      };
      history = [entry, ...history].slice(0, MAX_ITEMS);
      render();
      persist();

      // Reset capture so the next photo can be taken right away.
      fileInput.value = '';
      currentFile = null;
      preview.hidden = true;
      dropLabel.hidden = false;
      note.value = '';
      status.textContent = 'Sent. Answer is in the Answers tab.';
      showTab('answers');

      ask(entry, full);
    });

    clearBtn.addEventListener('click', () => {
      if (!confirm('Delete all saved answers on this device?')) return;
      history = [];
      persist();
      render();
    });

    $('snap-save-key').addEventListener('click', () => {
      const v = keyInput.value.trim();
      if (!v || v.startsWith('••')) return;
      save(KEY_STORE, v);
      keyInput.value = '••••••••';
      showTab('capture');
      status.textContent = 'Key saved.';
    });

    render();
    if (!getKey()) showTab('settings');
  }

  setup();
  document.addEventListener('astro:page-load', setup);
</script>

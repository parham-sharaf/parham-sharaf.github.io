---
import { site } from '../config';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

const links = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/publications', label: 'Publications' },
  { href: '/now', label: 'Now' },
  { href: '/about', label: 'About' },
];
---

<header class="fixed top-0 right-0 left-0 z-40 backdrop-blur-md" style="background: rgba(var(--color-bg-rgb), 0.6); border-bottom: 1px solid var(--color-border);">
  <nav class="container-page flex h-14 items-center justify-between">
    <a href="/" class="text-sm font-semibold tracking-tight">
      <span style="color: var(--color-fg)">{site.name}</span>
      <span style="color: var(--color-accent)">.</span>
    </a>
    <div class="flex items-center gap-1">
      <ul class="hidden items-center gap-1 text-sm sm:flex">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={isActive(l.href) ? 'page' : undefined}
                class="rounded px-3 py-1.5 transition-colors"
                style={
                  isActive(l.href)
                    ? 'color: var(--color-fg); background: var(--color-surface);'
                    : 'color: var(--color-fg-muted);'
                }
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <button
        type="button"
        class="nav-search-btn"
        aria-label="Search"
        data-action="search"
        title="Search (⌘K)"
      >
        <svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75">
          <circle cx="8.5" cy="8.5" r="5.5" />
          <line x1="13" y1="13" x2="17" y2="17" />
        </svg>
        <span class="nav-search-label">Search</span>
        <kbd class="nav-kbd">⌘K</kbd>
      </button>

      <button
        type="button"
        class="nav-icon-btn"
        aria-label="Toggle theme"
        data-action="theme"
        title="Toggle theme"
      >
        <svg class="theme-icon theme-icon-dark" width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
          <path d="M14.5 11.5A6 6 0 1 1 8.5 5a5 5 0 0 0 6 6.5z" />
        </svg>
        <svg class="theme-icon theme-icon-light" width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75">
          <circle cx="10" cy="10" r="3.5" />
          <line x1="10" y1="2" x2="10" y2="4" />
          <line x1="10" y1="16" x2="10" y2="18" />
          <line x1="2" y1="10" x2="4" y2="10" />
          <line x1="16" y1="10" x2="18" y2="10" />
          <line x1="4.2" y1="4.2" x2="5.6" y2="5.6" />
          <line x1="14.4" y1="14.4" x2="15.8" y2="15.8" />
          <line x1="4.2" y1="15.8" x2="5.6" y2="14.4" />
          <line x1="14.4" y1="5.6" x2="15.8" y2="4.2" />
        </svg>
      </button>

      <!-- Hamburger — mobile only -->
      <button
        type="button"
        class="nav-icon-btn sm:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-action="menu"
      >
        <svg class="menu-icon-open" width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
          <line x1="3" y1="6" x2="17" y2="6" />
          <line x1="3" y1="10" x2="17" y2="10" />
          <line x1="3" y1="14" x2="17" y2="14" />
        </svg>
        <svg class="menu-icon-close hidden" width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
          <line x1="5" y1="5" x2="15" y2="15" />
          <line x1="15" y1="5" x2="5" y2="15" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="mobile-menu sm:hidden"
    aria-hidden="true"
  >
    <ul class="mobile-menu-list">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            aria-current={isActive(l.href) ? 'page' : undefined}
            class="mobile-menu-link"
            style={isActive(l.href) ? 'color: var(--color-accent);' : ''}
            data-action="menu-link"
          >
            {l.label}
            {isActive(l.href) && <span class="mobile-active-dot" aria-hidden="true"></span>}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<style>
  .nav-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.375rem;
    color: var(--color-fg-muted);
    transition: all 140ms ease;
    cursor: pointer;
  }
  .nav-icon-btn:hover {
    color: var(--color-fg);
    background: var(--color-surface);
  }

  /* Search button — visible label + ⌘K hint on wider screens */
  .nav-search-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    height: 2rem;
    padding: 0 0.55rem;
    margin-right: 0.25rem;
    border-radius: 0.4rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg-soft);
    color: var(--color-fg-muted);
    font-size: 0.8125rem;
    transition: all 140ms ease;
    cursor: pointer;
  }
  .nav-search-btn:hover {
    color: var(--color-fg);
    border-color: var(--color-border-strong);
    background: var(--color-surface);
  }
  .nav-search-label {
    display: none;
  }
  @media (min-width: 640px) {
    .nav-search-label {
      display: inline;
    }
  }
  .nav-kbd {
    display: none;
    align-items: center;
    height: 1.25rem;
    padding: 0 0.35rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.25rem;
    background: var(--color-surface);
    color: var(--color-fg-dim);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1;
    letter-spacing: 0.02em;
  }
  @media (min-width: 640px) {
    .nav-kbd {
      display: inline-flex;
    }
  }
  .theme-icon-light { display: none; }
  html[data-theme='light'] .theme-icon-dark { display: none; }
  html[data-theme='light'] .theme-icon-light { display: inline; }

  /* Mobile menu */
  .mobile-menu {
    overflow: hidden;
    max-height: 0;
    transition: max-height 280ms cubic-bezier(0.2, 0.8, 0.2, 1);
    border-bottom: 1px solid transparent;
  }
  .mobile-menu.is-open {
    max-height: 24rem;
    border-bottom-color: var(--color-border);
  }
  .mobile-menu-list {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 0 0.75rem;
  }
  .mobile-menu-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.5rem;
    font-size: 0.9375rem;
    color: var(--color-fg-muted);
    transition: color 120ms ease, background 120ms ease;
  }
  .mobile-menu-link:hover {
    color: var(--color-fg);
    background: var(--color-surface);
  }
  .mobile-menu-link[aria-current='page'] {
    color: var(--color-accent);
  }
  .mobile-active-dot {
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 9999px;
    background: var(--color-accent);
    margin-left: auto;
  }
  .menu-icon-open,
  .menu-icon-close {
    transition: opacity 120ms ease;
  }
</style>

<script>
  function setupNav() {
    // Search trigger
    document.querySelectorAll<HTMLElement>('[data-action="search"]').forEach((btn) => {
      btn.onclick = () => {
        const palette = document.getElementById('search-palette');
        if (palette) {
          palette.hidden = false;
          requestAnimationFrame(() => palette.classList.add('is-open'));
          const input = document.getElementById('palette-input') as HTMLInputElement | null;
          input?.focus();
          document.body.style.overflow = 'hidden';
        }
      };
    });

    // Theme toggle
    document.querySelectorAll<HTMLElement>('[data-action="theme"]').forEach((btn) => {
      btn.onclick = () => {
        const current = document.documentElement.dataset.theme ?? 'dark';
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (_) {}
      };
    });

    // Mobile menu toggle
    const menuBtn = document.querySelector<HTMLButtonElement>('[data-action="menu"]');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = menuBtn?.querySelector<SVGElement>('.menu-icon-open');
    const iconClose = menuBtn?.querySelector<SVGElement>('.menu-icon-close');

    function closeMobileMenu() {
      if (!mobileMenu || !menuBtn) return;
      mobileMenu.classList.remove('is-open');
      mobileMenu.setAttribute('aria-hidden', 'true');
      menuBtn.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    if (menuBtn && mobileMenu) {
      menuBtn.onclick = () => {
        const isOpen = mobileMenu.classList.toggle('is-open');
        mobileMenu.setAttribute('aria-hidden', String(!isOpen));
        menuBtn.setAttribute('aria-expanded', String(isOpen));
        iconOpen?.classList.toggle('hidden', isOpen);
        iconClose?.classList.toggle('hidden', !isOpen);
      };
    }

    // Close menu when a link inside it is clicked
    document.querySelectorAll<HTMLElement>('[data-action="menu-link"]').forEach((link) => {
      link.onclick = closeMobileMenu;
    });

    // Keyboard shortcuts: g h / g p / g a / g n / g u / ? for help
    let buffer = '';
    let timer: number | null = null;
    const goto: Record<string, string> = {
      gh: '/',
      gp: '/projects',
      ga: '/about',
      gn: '/now',
      gu: '/publications',
    };
    document.onkeydown = (e) => {
      const target = e.target as HTMLElement;
      if (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable) return;
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      if (e.key === 'Escape') { closeMobileMenu(); return; }
      // Build-up 2-key sequence
      if (e.key.length === 1) {
        buffer += e.key.toLowerCase();
        if (timer) clearTimeout(timer);
        timer = window.setTimeout(() => { buffer = ''; }, 800);
        if (goto[buffer]) {
          e.preventDefault();
          const href = goto[buffer];
          buffer = '';
          closeMobileMenu();
          // @ts-ignore
          if (window.astro?.navigate) {
            // @ts-ignore
            window.astro.navigate(href);
          } else {
            location.href = href;
          }
        }
      }
    };
  }
  setupNav();
  document.addEventListener('astro:page-load', setupNav);
</script>
